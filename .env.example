# GOOGLE_GENAI_API_KEY / GEMINI_API_KEY: Required for Gemini AI API calls on the server.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GOOGLE_GENAI_API_KEY=

# VITE_GEMINI_API_KEY: Optional client-side key for static deployment (e.g. GitHub Pages)
VITE_GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

